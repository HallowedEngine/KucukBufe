# BüfeOS Environment Variables (Production)

# Database (Railway/Render otomatik verir)
DATABASE_URL=postgresql://user:password@host:port/database

# Secret Keys (Değiştir!)
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET=another-secret-key-for-jwt-tokens

# App Config
APP_NAME=BüfeOS
APP_VERSION=2.0.0
ENVIRONMENT=production

# Email (Future - bildirimler için)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Payment (Future - Stripe/İyzico)
STRIPE_API_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Domain
ALLOWED_ORIGINS=https://bufeos.com,https://www.bufeos.com
